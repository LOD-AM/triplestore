# Webhook receiver for new pipeline releases (LOD-AM/planning#7). Installed by deploy/install.sh,
# together with its script in /usr/local/lib/lodam/. It runs as an unprivileged dynamic user and can only write the trigger
# file in /run/lodam-release; lodam-update-published.path does the rest. Port 9300 must be
# reachable only from the data LXC (Proxmox firewall).
[Unit]
Description=LOD-AM release webhook (planning#7)
After=network-online.target
Wants=network-online.target
# Restarts on failure; if it fails 5 times within 10 minutes it stays down and mails the owner
# (deploy/alert.sh, planning#34)
StartLimitIntervalSec=10min
StartLimitBurst=5
OnFailure=lodam-alert@%n.service

[Service]
# A root-owned copy (deploy/install.sh): the dynamic user can't read the checkout in a home
# directory (Debian homes are 750/700), and it must not be able to change the script either.
ExecStart=/usr/bin/python3 /usr/local/lib/lodam/webhook.py
Environment=LODAM_WEBHOOK_LISTEN=0.0.0.0:9300
LoadCredential=token:/etc/lodam/webhook-token
DynamicUser=yes
RuntimeDirectory=lodam-release
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
Restart=on-failure
RestartSec=5
# Hardening: nothing but a listening socket and its trigger file
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=yes
LockPersonality=yes
MemoryMax=64M

[Install]
WantedBy=multi-user.target
