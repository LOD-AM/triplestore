# Copy to .env (gitignored) and fill in. docker compose reads .env itself.
#   cp .env.example .env && chmod 600 .env
# Values below are placeholders. Never commit real ones.

# Fuseki
FUSEKI_ADMIN_PASSWORD=change-me
FUSEKI_JAVA_OPTS=-Xmx4G

# Watchtower email notifications
WATCHTOWER_NOTIFICATIONS=email
WATCHTOWER_NOTIFICATION_EMAIL_FROM=watchtower@example.invalid
WATCHTOWER_NOTIFICATION_EMAIL_TO=admin@example.invalid
WATCHTOWER_NOTIFICATION_EMAIL_SERVER=smtp.example.invalid
WATCHTOWER_NOTIFICATION_EMAIL_SERVER_PORT=587
WATCHTOWER_NOTIFICATION_EMAIL_SERVER_USER=smtp-user
WATCHTOWER_NOTIFICATION_EMAIL_SERVER_PASSWORD=change-me
WATCHTOWER_NOTIFICATION_EMAIL_DELAY=2

# Used by scripts/load.sh (defaults to http://localhost:3030)
# FUSEKI_URL=http://localhost:3030
